# IncidentAI Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (Default: SQLite for zero-config local run, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./incidentai.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://incidentai:incidentai_secret@localhost:5432/incidentai_db

# Redis (optional for local, uses in-memory broadcast if unreachable)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Optional: Mock engine is used if none provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-incident-gpt

# Telemetry Configuration
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686
TELEMETRY_MODE=synthetic # 'synthetic' or 'live'
